    const TOTAL_LS_OT = 1381;
    const TOTAL_LS_NT = 603;
    const TOTAL_LS = TOTAL_LS_OT + TOTAL_LS_NT;

    const OT_BOOKS_SHORT_SET = new Set(["創", "出", "利", "民", "申", "書", "士", "得", "撒", "王", "代", "拉", "尼", "斯", "伯", "詩", "箴", "傳", "歌", "賽", "耶", "哀", "結", "但", "何", "珥", "摩", "俄", "拿", "彌", "鴻", "哈", "番", "該", "亞", "瑪"]);
    const NT_BOOKS_SHORT_SET = new Set(["太", "可", "路", "約", "徒", "羅", "林前", "林後", "加", "弗", "腓", "西", "帖前", "帖後", "提前", "提後", "多", "門", "希", "雅", "彼前", "彼後", "約壹", "約貳", "約參", "猶", "啟"]);

    function formatLsName(lsName) {
      if (!lsName) return { prefix: "", num: "" };
      if (lsName === "無") return { prefix: "無", num: "" };
      // 解析 "創生讀26" 或 "得生讀 1" -> {prefix: "創", num: "26"}
      const match = lsName.match(/^(.+?)生讀\s?(\d+.*)$/);
      if (match) return { prefix: match[1], num: match[2] };
      return { prefix: lsName, num: "" };
    }

    // Helper to extract LS from mapping
    function getLsForRange(rangeStr) {
      if (!rangeStr) return [];
      // 嘗試精確匹配 (CSV 轉出的 JSON 鍵值)
      const key = rangeStr.trim();
      if (lsMapping.range_map[key]) return lsMapping.range_map[key];

      // 模糊匹配 (處理可能的空白字元差異)
      const normalizedKey = key.replace(/\s+/g, '');
      for (let k in lsMapping.range_map) {
        if (k.replace(/\s+/g, '') === normalizedKey) return lsMapping.range_map[k];
      }
      return [];
    }

    function renderLsSection(day) {
      const lsWrap = document.getElementById('ls-chips-wrap');
      const lsSection = document.getElementById('ls-section');
      lsWrap.innerHTML = '';

      const parts = YEAR_PLAN_DATA[day - 1].split(' / ');
      const otRange = parts[0];
      const ntRange = parts[1] || '';

      const lsList = [...getLsForRange(otRange), ...getLsForRange(ntRange)];
      const uniqueLs = Array.from(new Set(lsList)).filter(name => {
        return name && name !== "無" && name !== "＿" && name.includes("生讀");
      });

      if (uniqueLs.length === 0) {
        lsSection.style.display = 'none';
        return;
      }

      lsSection.style.display = 'block';
      const lsDoneSet = new Set(globalProgress['LifeStudy'] || []);

      // 按書卷分組
      const groups = {};
      uniqueLs.forEach(lsName => {
        if (!lsName || lsName === "無" || lsName === "＿" || !lsName.includes("生讀")) return;
        const info = formatLsName(lsName);
        if (!groups[info.prefix]) groups[info.prefix] = [];
        groups[info.prefix].push({ name: lsName, num: info.num });
      });

      for (let prefix in groups) {
        const groupRow = document.createElement('div');
        groupRow.style.width = '100%';
        groupRow.style.marginBottom = '8px';
        groupRow.style.display = 'flex';
        groupRow.style.flexWrap = 'wrap';
        groupRow.style.gap = '8px';
        groupRow.style.alignItems = 'center';

        const label = document.createElement('span');
        label.style.color = '#f39c12';
        label.style.fontSize = '13px';
        label.style.fontWeight = 'bold';
        label.style.marginRight = '4px';
        label.innerText = prefix + '：';
        groupRow.appendChild(label);

        groups[prefix].forEach(item => {
          const chip = document.createElement('div');
          const isDone = lsDoneSet.has(item.name);
          chip.className = 'ls-chip' + (isDone ? ' done' : '');
          chip.dataset.lsName = item.name;
